@using ArtHouse.Models.Enums

@model ArtHouse.ViewModels.Orders.OrderListViewModel

<div class="container mt-5">

    <h2 class="mb-4">All Orders</h2>

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-info">

            You have not placed any orders yet.

        </div>
    }
    else
    {
        <table class="table table-striped table-hover">

            <thead class="table-dark">

                <tr>

                    <th>Order #</th>

                    <th>Customer</th>

                    <th>Date</th>

                    <th>Total Items</th>

                    <th>Total Price</th>

                    <th>Status</th>

                    <th class="text-center">Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Orders)
                {
                    <tr>

                        <td>@item.Id</td>

                        <td>@item.UserName</td>

                        <td>@item.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>

                        <td>@item.TotalItems</td>

                        <td>@item.TotalPrice.ToString("N0")</td>

                        <td>

                            <select class="form-select form-select-sm order-status"
                                    style="width:170px;"
                                    data-order-id="@item.Id">

                                @foreach (var status in Enum.GetValues<OrderStatus>())
                                {
                                    if (status == item.Status)
                                    {
                                        <option value="@status" selected>@status</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@status</option>
                                    }
                                }

                            </select>

                        </td>

                        <td class="text-center">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">

                                View Details

                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>


@section Scripts
{
    <script>

        document.querySelectorAll(".order-status").forEach(function (dropdown)
        {
            dropdown.addEventListener("change", function ()
            {
                const orderId = this.dataset.orderId;
                const status = this.value;

                fetch("/Order/UpdateStatus",
                {
                    method: "POST",

                    headers:
                    {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },

                    body: `orderId=${orderId}&status=${status}`
                })
                .then(response =>
                {
                    if (response.ok)
                    {
                        showToast("Order status updated successfully.");
                    }
                    else
                    {
                        showToast("Failed to update order status.", "danger");
                    }
                });

            });

        });

    </script>
}