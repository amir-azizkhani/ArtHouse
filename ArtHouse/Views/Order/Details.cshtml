@model ArtHouse.ViewModels.Orders.OrderDetailsViewModel

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Order #@Model.OrderId</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="AdminOrders"
               class="btn btn-outline-secondary">
                ← Back to All Orders
            </a>
        }
        else
        {
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                ← Back to My Orders
            </a>
        }

    </div>

    <div class="card mb-4">

        <div class="card-body">

            <p>
                <strong>Order Date:</strong>
                @Model.OrderDate.ToString("yyyy/MM/dd HH:mm")
            </p>

            <p>
                <strong>Total Price:</strong>
                @Model.TotalPrice.ToString("N0")
            </p>

        </div>

    </div>

    <table class="table table-striped table-hover">

        <thead class="table-dark">

            <tr>

                <th>Image</th>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model.Items)
            {
                <tr>

                    <td style="width:120px;">

                        <img src="@item.ImageUrl"
                             class="img-fluid rounded"
                             style="height:80px;object-fit:cover;" />

                    </td>

                    <td>@item.Title</td>

                    <td>@item.Price.ToString("N0")</td>

                    <td>@item.Quantity</td>

                    <td>@item.TotalPrice.ToString("N0")</td>

                </tr>
            }

        </tbody>

    </table>

</div>